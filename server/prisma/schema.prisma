generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  fullName        String
  email           String             @unique
  password        String
  role            UserRole           @default(EMPLOYEE)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  tenantId        String
  attachments     Attachment[]
  comments        Comment[]
  activityLogs    ActivityLog[]
  clients         Client[]
  employee        Employee?
  Lead            Lead[]
  notifications   Notification[]
  managedProjects Project[]          @relation("ProjectManager")
  memberships     TenantMembership[]
  tenant          Tenant            @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model Employee {
  id               String            @id @default(cuid())
  employeeCode     String            @unique
  phone            String?
  designation      String?
  department       String?
  joiningDate      DateTime?
  salary           Decimal?          @db.Decimal(12, 2)
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  userId           String            @unique
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payrolls         Payroll[]
  timesheets       Timesheet[]
  attendances      Attendance[]
  dailyWorkReports DailyWorkReport[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaves           Leave[]
  task             Task[]

  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("employees")
}

model Client {
  id               String    @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String    @unique
  phone            String?
  gstNumber        String?
  website          String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  isActive         Boolean   @default(true)
  accountManagerId String?
  tenantId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoices         Invoice[]
  accountManager   User?     @relation(fields: [accountManagerId], references: [id])
  projects         Project[]
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model Project {
  id               String            @id @default(cuid())
  projectCode      String            @unique
  name             String
  description      String?
  status           ProjectStatus     @default(PLANNING)
  priority         ProjectPriority   @default(MEDIUM)
  startDate        DateTime?
  endDate          DateTime?
  budget           Decimal?          @db.Decimal(12, 2)
  progress         Int               @default(0)
  clientId         String
  managerId        String?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      Attachment[]
  comments         Comment[]
  invoices         Invoice[]
  milestones       Milestone[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([clientId, tenantId])
  @@index([tenantId])
  @@map("projects")
}

model Task {
  id               String            @id @default(cuid())
  taskCode         String            @unique
  title            String
  description      String?
  status           TaskStatus        @default(TODO)
  priority         TaskPriority      @default(MEDIUM)
  dueDate          DateTime?
  estimatedHours   Decimal?          @db.Decimal(5, 2)
  actualHours      Decimal?          @db.Decimal(5, 2)
  projectId        String
  employeeId       String?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      Attachment[]
  comments         Comment[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId, tenantId])
  @@index([tenantId])
  @@map("tasks")
}

model Attendance {
  id         String    @id @default(cuid())
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  remarks    String?
  employeeId String
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([date, tenantId])
  @@index([tenantId])
  @@map("attendance")
}

model Leave {
  id         String      @id @default(cuid())
  reason     String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  remarks    String?
  employeeId String
  tenantId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leaveType  LeaveType   @default(CASUAL)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([status, tenantId])
  @@index([tenantId])
  @@map("leaves")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([isRead, tenantId])
  @@index([tenantId])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  description String?
  ipAddress   String?
  userAgent   String?
  userId      String?
  tenantId    String
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([module, tenantId])
  @@index([action, tenantId])
  @@index([tenantId])
  @@map("activity_logs")
}

model DailyWorkReport {
  id             String     @id @default(cuid())
  reportDate     DateTime
  yesterdayWork  String?
  todayWork      String
  tomorrowPlan   String?
  hoursWorked    Decimal    @db.Decimal(4, 2)
  status         WorkStatus @default(COMPLETED)
  managerRemarks String?
  employeeId     String
  projectId      String?
  taskId         String?
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id])
  task           Task?      @relation(fields: [taskId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([reportDate, tenantId])
  @@index([tenantId])
  @@map("daily_work_reports")
}

model Timesheet {
  id          String    @id @default(cuid())
  employeeId  String
  projectId   String?
  taskId      String?
  workDate    DateTime
  startTime   DateTime?
  endTime     DateTime?
  hours       Decimal   @db.Decimal(4, 2)
  description String?
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id])
  task        Task?     @relation(fields: [taskId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([workDate, tenantId])
  @@index([tenantId])
}

model Milestone {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus   @default(NOT_STARTED)
  priority    MilestonePriority @default(MEDIUM)
  progress    Int               @default(0)
  startDate   DateTime
  deadline    DateTime
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  projectId   String
  tenantId    String
  attachments Attachment[]
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId, tenantId])
  @@index([tenantId])
}

model Comment {
  id          String       @id @default(cuid())
  message     String
  projectId   String?
  taskId      String?
  userId      String
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Attachment {
  id           String     @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  fileUrl      String
  projectId    String?
  taskId       String?
  milestoneId  String?
  commentId    String?
  uploadedBy   String
  tenantId     String
  createdAt    DateTime   @default(now())
  comment      Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([uploadedBy, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Lead {
  id             String     @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String?
  phone          String?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  remarks        String?
  assignedToId   String?
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  followUps      FollowUp[]
  assignedTo     User?      @relation(fields: [assignedToId], references: [id])
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  nextFollowUp DateTime
  remarks      String
  isCompleted  Boolean  @default(false)
  tenantId     String
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId, tenantId])
  @@index([nextFollowUp, tenantId])
  @@index([tenantId])
  @@map("follow_ups")
}

model Payroll {
  id             String        @id @default(cuid())
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal       @db.Decimal(12, 2)
  totalHours     Decimal       @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal       @default(0) @db.Decimal(6, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  bonus          Decimal       @default(0) @db.Decimal(12, 2)
  netSalary      Decimal       @db.Decimal(12, 2)
  status         PayrollStatus @default(PENDING)
  generatedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  allowances     Decimal       @default(0) @db.Decimal(12, 2)
  esi            Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary    Decimal       @default(0) @db.Decimal(12, 2)
  hra            Decimal       @default(0) @db.Decimal(12, 2)
  incentives     Decimal       @default(0) @db.Decimal(12, 2)
  overtimeAmount Decimal       @default(0) @db.Decimal(12, 2)
  payslipNo      String?       @unique
  pf             Decimal       @default(0) @db.Decimal(12, 2)
  tds            Decimal       @default(0) @db.Decimal(12, 2)
  totalDeduction Decimal       @default(0) @db.Decimal(12, 2)
  tenantId       String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year, tenantId])
  @@index([employeeId, tenantId])
  @@index([month, year, tenantId])
  @@index([tenantId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  projectId     String?
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  tenantId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(8, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  tenantId    String
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, tenantId])
  @@index([tenantId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod
  referenceNo String?
  remarks     String?
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, tenantId])
  @@index([paymentDate, tenantId])
  @@index([tenantId])
}

model Tenant {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  status      TenantStatus       @default(ACTIVE)
  maxUsers    Int                @default(10)
  maxStorage  Int                @default(1024)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
  users       User[]
  clients     Client[]
  leads       Lead[]
  invoices    Invoice[]
  projects    Project[]
  tasks       Task[]
  employees   Employee[]
  attendances Attendance[]
  leaves      Leave[]
  notifications Notification[]
  activityLogs ActivityLog[]
  dailyWorkReports DailyWorkReport[]
  timesheets  Timesheet[]
  milestones  Milestone[]
  comments    Comment[]
  attachments Attachment[]
  followUps   FollowUp[]
  payrolls    Payroll[]
  invoiceItems InvoiceItem[]
  payments    Payment[]

  @@map("tenants")
}

model TenantMembership {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  role     UserRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum PayrollStatus {
  PENDING
  GENERATED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  GOOGLE
  REFERRAL
  WHATSAPP
  OTHER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}
