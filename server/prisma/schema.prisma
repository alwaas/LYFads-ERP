generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model User {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  password String
  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)

  employee Employee?
  clients  Client[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  managedProjects Project[]      @relation("ProjectManager")
  notifications   Notification[]
  activityLogs    ActivityLog[]

  @@map("users")
}

model Employee {
  id String @id @default(cuid())

  employeeCode String @unique

  phone String?

  designation String?

  department String?

  joiningDate DateTime?

  salary Decimal? @db.Decimal(12, 2)

  address String?

  city String?

  state String?

  country String?

  pincode String?

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt        DateTime          @updatedAt
  Task             Task[]
  attendances      Attendance[]
  leaves           Leave[]
  dailyWorkReports DailyWorkReport[]

  @@map("employees")
}

model Client {
  id String @id @default(cuid())

  companyName String

  contactPerson String

  email String @unique

  phone String?

  gstNumber String?

  website String?

  address String?

  city String?

  state String?

  country String?

  pincode String?

  projects Project[]

  isActive Boolean @default(true)

  accountManagerId String?

  accountManager User? @relation(fields: [accountManagerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Project {
  id String @id @default(cuid())

  projectCode String  @unique
  name        String
  description String?

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  startDate DateTime?
  endDate   DateTime?
  tasks     Task[]

  budget Decimal? @db.Decimal(12, 2)

  progress Int @default(0)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyWorkReports DailyWorkReport[]

  @@map("projects")
}

model Task {
  id String @id @default(cuid())

  taskCode    String  @unique
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  estimatedHours Decimal? @db.Decimal(5, 2)
  actualHours    Decimal? @db.Decimal(5, 2)

  projectId  String
  employeeId String?

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  dailyWorkReports DailyWorkReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Attendance {
  id String @id @default(cuid())

  date DateTime @default(now())

  checkIn DateTime?

  checkOut DateTime?

  status String @default("PRESENT")

  remarks String?

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id String @id @default(cuid())

  leaveType LeaveType @default(CASUAL)

  reason String

  startDate DateTime

  endDate DateTime

  status LeaveStatus @default(PENDING)

  remarks String?

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  isRead Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ActivityLog {
  id String @id @default(cuid())

  action String

  module String

  description String?

  ipAddress String?

  userAgent String?

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@map("activity_logs")
}

model DailyWorkReport {
  id String @id @default(cuid())

  reportDate DateTime

  yesterdayWork String?

  todayWork String

  tomorrowPlan String?

  hoursWorked Decimal @db.Decimal(4, 2)

  status WorkStatus @default(COMPLETED)

  managerRemarks String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([reportDate])
  @@index([status])
  @@map("daily_work_reports")
}
