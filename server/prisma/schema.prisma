generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  fullName           String
  email              String             @unique
  password           String
  role               UserRole           @default(EMPLOYEE)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenantId           String
  attachments        Attachment[]
  comments           Comment[]
  approvedPayrolls   Payroll[]
  approvedTimesheets Timesheet[]
  activityLogs       ActivityLog[]
  clients            Client[]
  employee           Employee?
  Lead               Lead[]
  approvedLeaves     Leave[]
  notifications      Notification[]
  managedProjects    Project[]          @relation("ProjectManager")
   memberships        TenantMembership[]
   tenant             Tenant             @relation(fields: [tenantId], references: [id])
    createdJournalEntries JournalEntry[]
  createdExpenses    Expense[] @relation("CreatedExpenses")
  approvedExpenses   Expense[] @relation("ApprovedExpenses")

  @@map("users")
}

model Employee {
  id                    String            @id @default(cuid())
  employeeCode          String            @unique
  phone                 String?
  designation           String?
  department            String?
  joiningDate           DateTime?
  salary                Decimal?          @db.Decimal(12, 2)
  address               String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  userId                String            @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenantId              String
  bankAccountNumber     String?
  bankName              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  ifscCode              String?
  managerId             String?
  status                EmploymentStatus  @default(ACTIVE)
  payrolls              Payroll[]
  timesheets            Timesheet[]
  attendances           Attendance[]
  dailyWorkReports      DailyWorkReport[]
  manager               Employee?         @relation("ManagerRelation", fields: [managerId], references: [id])
  managedEmployees      Employee[]        @relation("ManagerRelation")
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveBalances         LeaveBalance[]
  leaves                Leave[]
  salaryStructures      SalaryStructure[]
  task                  Task[]
  expenses              Expense[]

  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("employees")
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String       @unique
  phone            String?
  gstNumber        String?
  website          String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  isActive         Boolean      @default(true)
  accountManagerId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenantId         String
  invoices         Invoice[]
  accountManager   User?        @relation(fields: [accountManagerId], references: [id])
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects         Project[]
  salesOrders      SalesOrder[]

  @@map("clients")
}

model Project {
  id               String            @id @default(cuid())
  projectCode      String
  name             String
  description      String?
  status           ProjectStatus     @default(PLANNING)
  priority         ProjectPriority   @default(MEDIUM)
  startDate        DateTime?
  endDate          DateTime?
  budget           Decimal?          @db.Decimal(12, 2)
  progress         Int               @default(0)
  clientId         String
  managerId        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenantId         String
  attachments      Attachment[]
  comments         Comment[]
  invoices         Invoice[]
  milestones       Milestone[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@unique([projectCode, tenantId])
  @@index([clientId, tenantId])
  @@index([tenantId])
  @@map("projects")
}

model Task {
  id               String            @id @default(cuid())
  taskCode         String
  title            String
  description      String?
  status           TaskStatus        @default(TODO)
  priority         TaskPriority      @default(MEDIUM)
  dueDate          DateTime?
  estimatedHours   Decimal?          @db.Decimal(5, 2)
  actualHours      Decimal?          @db.Decimal(5, 2)
  projectId        String
  employeeId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenantId         String
  attachments      Attachment[]
  comments         Comment[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([taskCode, tenantId])
  @@index([projectId, tenantId])
  @@index([tenantId])
  @@map("tasks")
}

model Attendance {
  id         String           @id @default(cuid())
  date       DateTime         @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  remarks    String?
  employeeId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenantId   String
  status     AttendanceStatus @default(PRESENT)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([date, tenantId])
  @@index([tenantId])
  @@map("attendance")
}

model Leave {
  id              String      @id @default(cuid())
  reason          String
  startDate       DateTime
  endDate         DateTime
  status          LeaveStatus @default(PENDING)
  remarks         String?
  employeeId      String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  leaveType       LeaveType   @default(CASUAL)
  tenantId        String
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  approvedBy      User?       @relation(fields: [approvedById], references: [id])
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([status, tenantId])
  @@index([tenantId])
  @@map("leaves")
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  leaveType  LeaveType
  year       Int
  allocated  Int       @default(0)
  used       Int       @default(0)
  remaining  Int       @default(0)
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year, tenantId])
  @@index([employeeId, tenantId])
  @@index([tenantId])
  @@map("leave_balances")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([isRead, tenantId])
  @@index([tenantId])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  description String?
  ipAddress   String?
  userAgent   String?
  userId      String?
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
  @@index([module, tenantId])
  @@index([action, tenantId])
  @@index([tenantId])
  @@map("activity_logs")
}

model DailyWorkReport {
  id             String     @id @default(cuid())
  reportDate     DateTime
  yesterdayWork  String?
  todayWork      String
  tomorrowPlan   String?
  hoursWorked    Decimal    @db.Decimal(4, 2)
  status         WorkStatus @default(COMPLETED)
  managerRemarks String?
  employeeId     String
  projectId      String?
  taskId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenantId       String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id])
  task           Task?      @relation(fields: [taskId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([reportDate, tenantId])
  @@index([tenantId])
  @@map("daily_work_reports")
}

model Timesheet {
  id              String          @id @default(cuid())
  employeeId      String
  projectId       String?
  taskId          String?
  workDate        DateTime
  startTime       DateTime?
  endTime         DateTime?
  hours           Decimal         @db.Decimal(4, 2)
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenantId        String
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  status          TimesheetStatus @default(DRAFT)
  approvedBy      User?           @relation(fields: [approvedById], references: [id])
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id])
  task            Task?           @relation(fields: [taskId], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([workDate, tenantId])
  @@index([tenantId])
}

model Milestone {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus   @default(NOT_STARTED)
  priority    MilestonePriority @default(MEDIUM)
  progress    Int               @default(0)
  startDate   DateTime
  deadline    DateTime
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  projectId   String
  tenantId    String
  attachments Attachment[]
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId, tenantId])
  @@index([tenantId])
}

model Comment {
  id          String       @id @default(cuid())
  message     String
  projectId   String?
  taskId      String?
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenantId    String
  attachments Attachment[]
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Attachment {
  id           String     @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  fileUrl      String
  projectId    String?
  taskId       String?
  milestoneId  String?
  commentId    String?
  uploadedBy   String
  createdAt    DateTime   @default(now())
  tenantId     String
  comment      Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Lead {
  id             String     @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String?
  phone          String?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  remarks        String?
  assignedToId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  tenantId       String
  followUps      FollowUp[]
  assignedTo     User?      @relation(fields: [assignedToId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  nextFollowUp DateTime
  remarks      String
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  tenantId     String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId, tenantId])
  @@index([nextFollowUp, tenantId])
  @@index([tenantId])
  @@map("follow_ups")
}

model Payroll {
  id               String         @id @default(cuid())
  employeeId       String
  month            Int
  year             Int
  basicSalary      Decimal        @db.Decimal(12, 2)
  totalHours       Decimal        @default(0) @db.Decimal(6, 2)
  overtimeHours    Decimal        @default(0) @db.Decimal(6, 2)
  deductions       Decimal        @default(0) @db.Decimal(12, 2)
  bonus            Decimal        @default(0) @db.Decimal(12, 2)
  netSalary        Decimal        @db.Decimal(12, 2)
  status           PayrollStatus  @default(PENDING)
  generatedAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  allowances       Decimal        @default(0) @db.Decimal(12, 2)
  esi              Decimal        @default(0) @db.Decimal(12, 2)
  grossSalary      Decimal        @default(0) @db.Decimal(12, 2)
  hra              Decimal        @default(0) @db.Decimal(12, 2)
  incentives       Decimal        @default(0) @db.Decimal(12, 2)
  overtimeAmount   Decimal        @default(0) @db.Decimal(12, 2)
  payslipNo        String?        @unique
  pf               Decimal        @default(0) @db.Decimal(12, 2)
  tds              Decimal        @default(0) @db.Decimal(12, 2)
  totalDeduction   Decimal        @default(0) @db.Decimal(12, 2)
  tenantId         String
  approvedAt       DateTime?
  approvedById     String?
  paymentMethod    PaymentMethod?
  paymentReference String?
  approvedBy       User?          @relation(fields: [approvedById], references: [id])
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items            PayrollItem[]

  @@unique([employeeId, month, year, tenantId])
  @@index([employeeId, tenantId])
  @@index([month, year, tenantId])
  @@index([tenantId])
}

model SalaryStructure {
  id            String    @id @default(cuid())
  employeeId    String
  basicSalary   Decimal   @db.Decimal(12, 2)
  hra           Decimal   @default(0) @db.Decimal(12, 2)
  allowances    Decimal   @default(0) @db.Decimal(12, 2)
  bonus         Decimal   @default(0) @db.Decimal(12, 2)
  incentives    Decimal   @default(0) @db.Decimal(12, 2)
  deductions    Decimal   @default(0) @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([tenantId])
  @@index([isActive, tenantId])
  @@map("salary_structures")
}

model PayrollItem {
  id          String          @id @default(cuid())
  payrollId   String
  type        PayrollItemType
  category    String
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  sequence    Int             @default(0)
  tenantId    String
  createdAt   DateTime        @default(now())
  payroll     Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([payrollId, tenantId])
  @@index([tenantId])
  @@map("payroll_items")
}

model Invoice {
  id            String              @id @default(cuid())
  invoiceNumber String              @unique
  clientId      String
  projectId     String?
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Decimal             @db.Decimal(12, 2)
  tax           Decimal             @default(0) @db.Decimal(12, 2)
  discount      Decimal             @default(0) @db.Decimal(12, 2)
  total         Decimal             @db.Decimal(12, 2)
  paidAmount    Decimal             @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal             @db.Decimal(12, 2)
  status        InvoiceStatus       @default(DRAFT)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenantId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId], references: [id])
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]
  allocations   PaymentAllocation[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(8, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  tenantId    String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, tenantId])
  @@index([tenantId])
}

model Payment {
  id                String              @id @default(cuid())
  invoiceId         String?
  purchaseInvoiceId String?
  amount            Decimal             @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod
  referenceNo String?
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenantId    String
  status      PaymentStatus       @default(ACTIVE)
  voidedAt    DateTime?
  voidedById  String?
  invoice          Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseInvoice  PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations      PaymentAllocation[]

  @@index([invoiceId, tenantId])
  @@index([purchaseInvoiceId, tenantId])
  @@index([paymentDate, tenantId])
  @@index([tenantId])
  @@index([status, tenantId])
}

model PaymentAllocation {
  id                String   @id @default(cuid())
  paymentId         String
  invoiceId         String?
  purchaseInvoiceId String?
  amount            Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenantId  String
  invoice          Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseInvoice  PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  payment          Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@unique([paymentId, purchaseInvoiceId])
  @@index([paymentId, tenantId])
  @@index([invoiceId, tenantId])
  @@index([purchaseInvoiceId, tenantId])
  @@index([tenantId])
}

model Expense {
  id            String        @id @default(cuid())
  expenseDate   DateTime
  category      String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal?      @db.Decimal(12, 2)
  referenceNo   String?
  notes         String?
  paymentMethod PaymentMethod
  status        ExpenseStatus @default(DRAFT)
  receiptUrl    String?
  vendorId      String?
  employeeId    String?
  glAccountId   String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal?      @db.Decimal(12, 2)
  tenantId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation("TenantExpenses", fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy    User?         @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  glAccount     Account?      @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  @@index([expenseDate, tenantId])
  @@index([category, tenantId])
  @@index([status, tenantId])
  @@index([vendorId, tenantId])
  @@index([employeeId, tenantId])
  @@index([createdById, tenantId])
  @@index([tenantId])
  @@map("expenses")
}

model Purchase {
  id            String        @id @default(cuid())
  purchaseDate  DateTime
  referenceNo   String?
  description   String
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  tenantId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendorId      String
  paymentMethod PaymentMethod
  vendorInfo    Vendor        @relation(fields: [vendorId], references: [id])

  @@index([purchaseDate, tenantId])
  @@index([vendorId, tenantId])
  @@index([tenantId])
  @@map("purchases")
}

model Vendor {
  id            String     @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  gstNumber     String?
  isActive      Boolean    @default(true)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases         Purchase[]
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  expenses          Expense[]

  @@index([tenantId])
  @@index([name, tenantId])
  @@index([isActive, tenantId])
  @@map("vendors")
}

model PurchaseOrder {
  id                   String                @id @default(cuid())
  orderNumber          String
  vendorId             String
  warehouseId          String?
  orderDate            DateTime              @default(now())
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus   @default(DRAFT)
  subtotal             Decimal               @db.Decimal(12, 2)
  discount             Decimal               @default(0) @db.Decimal(12, 2)
  tax                  Decimal               @default(0) @db.Decimal(12, 2)
  total                Decimal               @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenantId             String
  items                PurchaseOrderItem[]
  purchaseInvoices     PurchaseInvoice[]
  vendor               Vendor                @relation(fields: [vendorId], references: [id])
  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([orderNumber, tenantId])
  @@index([tenantId])
  @@index([vendorId, tenantId])
  @@index([status, tenantId])
  @@index([orderDate, tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(12, 2)
  receivedQuantity Decimal      @default(0) @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
  sequence        Int           @default(0)
  createdAt       DateTime      @default(now())
  tenantId        String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: NoAction)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, tenantId])
  @@index([tenantId])
  @@map("purchase_order_items")
}

model PurchaseInvoice {
  id                String                @id @default(cuid())
  invoiceNumber     String
  vendorId          String
  purchaseOrderId   String?
  issueDate         DateTime              @default(now())
  dueDate           DateTime
  status            PurchaseInvoiceStatus @default(DRAFT)
  subtotal          Decimal               @db.Decimal(12, 2)
  tax               Decimal               @default(0) @db.Decimal(12, 2)
  discount          Decimal               @default(0) @db.Decimal(12, 2)
  total             Decimal               @db.Decimal(12, 2)
  amountPaid        Decimal               @default(0) @db.Decimal(12, 2)
  balanceAmount     Decimal               @db.Decimal(12, 2)
  notes             String?
  tenantId          String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             PurchaseInvoiceItem[]
  vendor            Vendor                @relation(fields: [vendorId], references: [id])
  purchaseOrder     PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]
  allocations       PaymentAllocation[]

  @@unique([invoiceNumber, tenantId])
  @@index([tenantId])
  @@index([vendorId, tenantId])
  @@index([purchaseOrderId, tenantId])
  @@index([status, tenantId])
  @@index([dueDate, tenantId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String          @id @default(cuid())
  purchaseInvoiceId String
  description       String
  quantity          Decimal         @db.Decimal(12, 2)
  unitCost          Decimal         @db.Decimal(12, 2)
  tax               Decimal         @default(0) @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)
  sequence          Int             @default(0)
  createdAt         DateTime        @default(now())
  tenantId          String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([purchaseInvoiceId, tenantId])
  @@index([tenantId])
  @@map("purchase_invoice_items")
}

model Tenant {
  id                       String                   @id @default(cuid())
  name                     String
  slug                     String                   @unique
  status                   TenantStatus             @default(ACTIVE)
  maxUsers                 Int                      @default(10)
  maxStorage               Int                      @default(1024)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  email                    String?
  phone                    String?
  address                  String?
  logo                     String?
  timezone                 String                   @default("UTC")
  currency                 String                   @default("USD")
  inventoryValuationMethod InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  attachments              Attachment[]
  comments                 Comment[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  milestones               Milestone[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  payrolls                 Payroll[]
  timesheets               Timesheet[]
  activityLogs             ActivityLog[]
  attendances              Attendance[]
  clients                  Client[]
  dailyWorkReports         DailyWorkReport[]
  employees                Employee[]
  followUps                FollowUp[]
  leads                    Lead[]
  leaveBalances            LeaveBalance[]
  leaves                   Leave[]
  notifications            Notification[]
  payrollItems             PayrollItem[]
  productWarehouses        ProductWarehouse[]
  fifoCostLayers           FifoCostLayer[]
  products                 Product[]
  projects                 Project[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseOrders           PurchaseOrder[]
  purchaseInvoiceItems     PurchaseInvoiceItem[]
   purchaseInvoices         PurchaseInvoice[]
   salaryStructures         SalaryStructure[]
   salesOrderItems          SalesOrderItem[]
   salesOrders              SalesOrder[]
    stockMovements           StockMovement[]
    tasks                    Task[]
    memberships              TenantMembership[]
    users                    User[]
    warehouses               Warehouse[]
    subscription             TenantSubscription?
    StockCount               StockCount[]
    StockCountLine           StockCountLine[]
    fiscalYears              FiscalYear[]
    accounts                 Account[]
    journalEntries           JournalEntry[]
    journalEntryLines        JournalEntryLine[]
    expenses                 Expense[]     @relation("TenantExpenses")

  @@map("tenants")
}

model TenantMembership {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  role     UserRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Plan {
  id              String               @id @default(cuid())
  name            String
  code            String               @unique
  description     String?
  price           Decimal              @default(0) @db.Decimal(12, 2)
  billingInterval BillingInterval      @default(MONTHLY)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  features        PlanFeature[]
  limits          PlanLimit[]
  subscriptions   TenantSubscription[]

  @@map("plans")
}

model PlanFeature {
  id          String   @id @default(cuid())
  planId      String
  featureCode String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([planId])
  @@map("plan_features")
}

model PlanLimit {
  id           String   @id @default(cuid())
  planId       String
  resourceCode String
  limitValue   Int      @default(-1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, resourceCode])
  @@index([planId])
  @@map("plan_limits")
}

model TenantSubscription {
  id           String             @id @default(cuid())
  tenantId     String             @unique
  planId       String
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndDate DateTime?
  autoRenew    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("tenant_subscriptions")
}

model Product {
  id              String             @id @default(cuid())
  tenantId        String
  sku             String
  name            String
  description     String?
  unitPrice       Decimal            @db.Decimal(12, 2)
  costPrice       Decimal            @db.Decimal(12, 2)
  stockQuantity   Int                @default(0)
  minStockLevel   Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  warehouseStocks ProductWarehouse[]
  fifoCostLayers  FifoCostLayer[]
  stockCountLines StockCountLine[]
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems SalesOrderItem[]
  stockMovements  StockMovement[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@index([name, tenantId])
  @@map("products")
}

model Warehouse {
  id                        String             @id @default(cuid())
  tenantId                  String
  name                      String
  location                  String?
  isDefault                 Boolean            @default(false)
  isActive                  Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  warehouseStocks           ProductWarehouse[]
  fifoCostLayers            FifoCostLayer[]
  stockCounts               StockCount[]
  purchaseOrders            PurchaseOrder[]
  destinationStockMovements StockMovement[]    @relation("DestinationStockMovements")
  sourceStockMovements      StockMovement[]    @relation("SourceStockMovements")
  stockMovements            StockMovement[]    @relation("StockMovements")
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("warehouses")
}

model ProductWarehouse {
  id          String          @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Int             @default(0)
  averageCost Decimal         @default(0) @db.Decimal(12, 4)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  fifoLayers  FifoCostLayer[]

  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@map("product_warehouses")
}

model StockCount {
  id          String           @id @default(cuid())
  tenantId    String
  warehouseId String
  countDate   DateTime         @default(now())
  status      String           @default("DRAFT")
  notes       String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines       StockCountLine[]

  @@index([tenantId, warehouseId])
  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id              String     @id @default(cuid())
  tenantId        String
  stockCountId    String
  productId       String
  countedQuantity Int
  systemQuantity  Int?
  variance        Int?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stockCountId])
  @@map("stock_count_lines")
}

model FifoCostLayer {
  id                 String           @id @default(cuid())
  tenantId           String
  productId          String
  warehouseId        String
  productWarehouseId String
  remainingQuantity  Int
  unitCost           Decimal          @db.Decimal(12, 4)
  receivedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  sourceMovementId   String?
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productWarehouse   ProductWarehouse @relation(fields: [productWarehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, productWarehouseId, receivedAt])
  @@index([tenantId, productWarehouseId, remainingQuantity])
  @@map("fifo_cost_layers")
}

model StockMovement {
  id                     String            @id @default(cuid())
  tenantId               String
  productId              String
  warehouseId            String?
  sourceWarehouseId      String?
  destinationWarehouseId String?
  type                   StockMovementType
  quantity               Int
  unitCost               Decimal?          @db.Decimal(12, 4)
  totalCost              Decimal?          @db.Decimal(14, 4)
  referenceType          String?
  referenceId            String?
  notes                  String?
  createdAt              DateTime          @default(now())
  destinationWarehouse   Warehouse?        @relation("DestinationStockMovements", fields: [destinationWarehouseId], references: [id])
  product                Product           @relation(fields: [productId], references: [id])
  sourceWarehouse        Warehouse?        @relation("SourceStockMovements", fields: [sourceWarehouseId], references: [id])
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse              Warehouse?        @relation("StockMovements", fields: [warehouseId], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model FiscalYear {
  id           String              @id @default(cuid())
  tenantId     String
  year         Int
  startDate    DateTime
  endDate      DateTime
  status       FiscalPeriodStatus  @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([year, tenantId])
  @@map("fiscal_years")
}

model Account {
  id               String          @id @default(cuid())
  tenantId         String
  code             String
  name             String
  type             AccountType     @default(OTHER)
  normalBalanceSide NormalBalanceSide @default(DEBIT)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryLines JournalEntryLine[]
  expenses          Expense[]

  @@unique([code, tenantId])
  @@index([tenantId, type])
  @@index([tenantId])
  @@map("accounts")
}

model JournalEntry {
  id            String           @id @default(cuid())
  tenantId      String
  fiscalYearId  String?
  date          DateTime
  description   String?
  referenceId   String?
  posted        Boolean          @default(false)
  postedAt      DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear    FiscalYear?      @relation(fields: [fiscalYearId], references: [id])
  createdBy     User?            @relation(fields: [createdById], references: [id])
  lines         JournalEntryLine[]

  @@index([tenantId, date])
  @@index([tenantId, posted])
  @@index([tenantId, referenceId])
  @@index([tenantId, fiscalYearId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id                String   @id @default(cuid())
  tenantId          String
  journalEntryId    String
  accountId         String
  debitAmount       Decimal  @db.Decimal(12, 2)
  creditAmount      Decimal  @db.Decimal(12, 2)
  description       String?
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry      JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id])

  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountId])
  @@index([tenantId])
  @@map("journal_entry_lines")
}

model SalesOrder {
  id                   String           @id @default(cuid())
  orderNumber          String
  clientId             String
  orderDate            DateTime         @default(now())
  expectedDeliveryDate DateTime?
  status               SalesOrderStatus @default(DRAFT)
  subtotal             Decimal          @db.Decimal(12, 2)
  discount             Decimal          @default(0) @db.Decimal(12, 2)
  tax                  Decimal          @default(0) @db.Decimal(12, 2)
  total                Decimal          @db.Decimal(12, 2)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  tenantId             String
  items                SalesOrderItem[]
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([orderNumber, tenantId])
  @@index([tenantId])
  @@index([clientId, tenantId])
  @@index([status, tenantId])
  @@index([orderDate, tenantId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Decimal    @db.Decimal(8, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
  discount     Decimal    @default(0) @db.Decimal(12, 2)
  tax          Decimal    @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal    @db.Decimal(12, 2)
  sequence     Int        @default(0)
  createdAt    DateTime   @default(now())
  tenantId     String
  product      Product    @relation(fields: [productId], references: [id], onDelete: NoAction)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([salesOrderId, tenantId])
  @@index([tenantId])
  @@map("sales_order_items")
}

