generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String             @id @default(cuid())
  fullName               String
  email                  String             @unique
  password               String
  role                   UserRole           @default(EMPLOYEE)
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenantId               String
  attachments            Attachment[]
  comments               Comment[]
  activityLogs           ActivityLog[]
  clients                Client[]
  employee               Employee?
  Lead                   Lead[]
  notifications          Notification[]
  managedProjects        Project[]          @relation("ProjectManager")
  memberships            TenantMembership[]
  expenses               Expense[]
  createdVendors         Vendor[]           @relation("CreatedVendors")
  createdPurchaseOrders  PurchaseOrder[]    @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders PurchaseOrder[]    @relation("ApprovedPurchaseOrders")
  createdSalesOrders     SalesOrder[]       @relation("CreatedSalesOrders")
  approvedSalesOrders    SalesOrder[]       @relation("ApprovedSalesOrders")
  createdStockMovements  StockMovement[]    @relation("CreatedStockMovements")
  createdInvoices        Invoice[]          @relation("CreatedInvoices")
  createdPayments        Payment[]          @relation("PaymentCreator")
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model Employee {
  id               String            @id @default(cuid())
  employeeCode     String            @unique
  phone            String?
  designation      String?
  department       String?
  joiningDate      DateTime?
  salary           Decimal?          @db.Decimal(12, 2)
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  userId           String            @unique
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payrolls         Payroll[]
  timesheets       Timesheet[]
  attendances      Attendance[]
  dailyWorkReports DailyWorkReport[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaves           Leave[]
  task             Task[]

  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("employees")
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String       @unique
  phone            String?
  gstNumber        String?
  website          String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  isActive         Boolean      @default(true)
  accountManagerId String?
  tenantId         String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  invoices         Invoice[]
  salesOrders      SalesOrder[]
  accountManager   User?        @relation(fields: [accountManagerId], references: [id])
  projects         Project[]
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model Project {
  id               String            @id @default(cuid())
  projectCode      String
  name             String
  description      String?
  status           ProjectStatus     @default(PLANNING)
  priority         ProjectPriority   @default(MEDIUM)
  startDate        DateTime?
  endDate          DateTime?
  budget           Decimal?          @db.Decimal(12, 2)
  progress         Int               @default(0)
  clientId         String
  managerId        String?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      Attachment[]
  comments         Comment[]
  invoices         Invoice[]
  milestones       Milestone[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager          User?             @relation("ProjectManager", fields: [managerId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@unique([projectCode, tenantId])
  @@index([clientId, tenantId])
  @@index([tenantId])
  @@map("projects")
}

model Task {
  id               String            @id @default(cuid())
  taskCode         String
  title            String
  description      String?
  status           TaskStatus        @default(TODO)
  priority         TaskPriority      @default(MEDIUM)
  dueDate          DateTime?
  estimatedHours   Decimal?          @db.Decimal(5, 2)
  actualHours      Decimal?          @db.Decimal(5, 2)
  projectId        String
  employeeId       String?
  tenantId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      Attachment[]
  comments         Comment[]
  timesheets       Timesheet[]
  dailyWorkReports DailyWorkReport[]
  employee         Employee?         @relation(fields: [employeeId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([taskCode, tenantId])
  @@index([projectId, tenantId])
  @@index([tenantId])
  @@map("tasks")
}

model Attendance {
  id         String    @id @default(cuid())
  date       DateTime  @default(now())
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  remarks    String?
  employeeId String
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([date, tenantId])
  @@index([tenantId])
  @@map("attendance")
}

model Leave {
  id         String      @id @default(cuid())
  reason     String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  remarks    String?
  employeeId String
  tenantId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leaveType  LeaveType   @default(CASUAL)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([status, tenantId])
  @@index([tenantId])
  @@map("leaves")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([isRead, tenantId])
  @@index([tenantId])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  module      String
  description String?
  ipAddress   String?
  userAgent   String?
  userId      String?
  tenantId    String
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([module, tenantId])
  @@index([action, tenantId])
  @@index([tenantId])
  @@map("activity_logs")
}

model DailyWorkReport {
  id             String     @id @default(cuid())
  reportDate     DateTime
  yesterdayWork  String?
  todayWork      String
  tomorrowPlan   String?
  hoursWorked    Decimal    @db.Decimal(4, 2)
  status         WorkStatus @default(COMPLETED)
  managerRemarks String?
  employeeId     String
  projectId      String?
  taskId         String?
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id])
  task           Task?      @relation(fields: [taskId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([reportDate, tenantId])
  @@index([tenantId])
  @@map("daily_work_reports")
}

model Timesheet {
  id          String    @id @default(cuid())
  employeeId  String
  projectId   String?
  taskId      String?
  workDate    DateTime
  startTime   DateTime?
  endTime     DateTime?
  hours       Decimal   @db.Decimal(4, 2)
  description String?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id])
  task        Task?     @relation(fields: [taskId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, tenantId])
  @@index([workDate, tenantId])
  @@index([tenantId])
}

model Milestone {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      MilestoneStatus   @default(NOT_STARTED)
  priority    MilestonePriority @default(MEDIUM)
  progress    Int               @default(0)
  startDate   DateTime
  deadline    DateTime
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  projectId   String
  tenantId    String
  attachments Attachment[]
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId, tenantId])
  @@index([tenantId])
}

model Comment {
  id          String       @id @default(cuid())
  message     String
  projectId   String?
  taskId      String?
  userId      String
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Attachment {
  id           String     @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  fileUrl      String
  projectId    String?
  taskId       String?
  milestoneId  String?
  commentId    String?
  uploadedBy   String
  tenantId     String
  createdAt    DateTime   @default(now())
  comment      Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([uploadedBy, tenantId])
  @@index([projectId, tenantId])
  @@index([taskId, tenantId])
  @@index([tenantId])
}

model Lead {
  id             String     @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String?
  phone          String?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  remarks        String?
  assignedToId   String?
  tenantId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  followUps      FollowUp[]
  assignedTo     User?      @relation(fields: [assignedToId], references: [id])
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model FollowUp {
  id           String   @id @default(cuid())
  leadId       String
  nextFollowUp DateTime
  remarks      String
  isCompleted  Boolean  @default(false)
  tenantId     String
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([leadId, tenantId])
  @@index([nextFollowUp, tenantId])
  @@index([tenantId])
  @@map("follow_ups")
}

model Payroll {
  id             String        @id @default(cuid())
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal       @db.Decimal(12, 2)
  totalHours     Decimal       @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal       @default(0) @db.Decimal(6, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  bonus          Decimal       @default(0) @db.Decimal(12, 2)
  netSalary      Decimal       @db.Decimal(12, 2)
  status         PayrollStatus @default(PENDING)
  generatedAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  allowances     Decimal       @default(0) @db.Decimal(12, 2)
  esi            Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary    Decimal       @default(0) @db.Decimal(12, 2)
  hra            Decimal       @default(0) @db.Decimal(12, 2)
  incentives     Decimal       @default(0) @db.Decimal(12, 2)
  overtimeAmount Decimal       @default(0) @db.Decimal(12, 2)
  payslipNo      String?       @unique
  pf             Decimal       @default(0) @db.Decimal(12, 2)
  tds            Decimal       @default(0) @db.Decimal(12, 2)
  totalDeduction Decimal       @default(0) @db.Decimal(12, 2)
  tenantId       String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year, tenantId])
  @@index([employeeId, tenantId])
  @@index([month, year, tenantId])
  @@index([tenantId])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  projectId     String?
  salesOrderId  String?
  invoiceNumber String
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal       @db.Decimal(12, 2)
  notes         String?
  createdById   String?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?            @relation(fields: [projectId], references: [id])
  salesOrder  SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  payments    Payment[]           @relation("InvoicePayments")
  createdBy   User?               @relation("CreatedInvoices", fields: [createdById], references: [id])
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([invoiceNumber, tenantId])
  @@index([clientId])
  @@index([status])
  @@index([salesOrderId])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id               String   @id @default(cuid())
  invoiceId        String
  salesOrderItemId String?
  productId        String?
  description      String
  quantity         Decimal  @db.Decimal(8, 2)
  unitPrice        Decimal  @db.Decimal(12, 2)
  taxRate          Decimal? @db.Decimal(5, 2)
  taxAmount        Decimal? @db.Decimal(12, 2)
  discount         Decimal? @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  tenantId         String
  createdAt        DateTime @default(now())

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId, tenantId])
  @@index([tenantId])
  @@map("invoice_items")
}

model Payment {
  id           String         @id @default(cuid())
  invoiceId    String?        // Legacy field for backwards compatibility
  clientId     String?
  amount       Decimal        @db.Decimal(12, 2)
  paymentDate  DateTime
  method       PaymentMethod
  referenceNo  String?
  remarks      String?
  status       PaymentStatus  @default(ACTIVE)
  createdById  String?
  tenantId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  invoice      Invoice?       @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("PaymentCreator", fields: [createdById], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations  PaymentAllocation[]

  @@index([invoiceId, tenantId])
  @@index([clientId, tenantId])
  @@index([paymentDate, tenantId])
  @@index([tenantId])
  @@index([status, tenantId])
  @@map("payments")
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  allocatedAt DateTime @default(now())
  tenantId    String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([paymentId, tenantId])
  @@index([invoiceId, tenantId])
  @@index([tenantId])
  @@map("payment_allocations")
}

model Expense {
  id            String          @id @default(cuid())
  description   String
  amount        Decimal         @db.Decimal(12, 2)
  expenseDate   DateTime
  category      ExpenseCategory
  paymentMethod PaymentMethod
  vendor        String
  vendorId      String?
  receiptUrl    String?
  notes         String?
  status        ExpenseStatus?
  userId        String
  tenantId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([vendorId, tenantId])
  @@index([expenseDate, tenantId])
  @@index([status, tenantId])
  @@index([tenantId])
  @@map("expenses")
}

model Vendor {
  id             String       @id @default(cuid())
  name           String
  vendorCode     String
  contactPerson  String?
  email          String?
  phone          String?
  alternatePhone String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  taxNumber      String?
  paymentTerms   String?
  notes          String?
  status         VendorStatus @default(ACTIVE)
  createdById    String?
  tenantId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdByUser  User?           @relation("CreatedVendors", fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([vendorCode, tenantId])
  @@index([createdById, tenantId])
  @@index([status, tenantId])
  @@index([tenantId])
  @@map("vendors")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  poNumber             String
  title                String
  description          String?
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @db.Decimal(12, 2)
  taxAmount            Decimal             @db.Decimal(12, 2)
  discountAmount       Decimal             @db.Decimal(12, 2)
  totalAmount          Decimal             @db.Decimal(12, 2)
  notes                String?
  createdById          String?
  approvedById         String?
  approvedAt           DateTime?
  tenantId             String
  vendorId             String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  createdBy  User?               @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  approvedBy User?               @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id])
  items      PurchaseOrderItem[]
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([poNumber, tenantId])
  @@index([vendorId, tenantId])
  @@index([status, tenantId])
  @@index([createdById, tenantId])
  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  productId        String?
  description      String
  quantity         Decimal  @db.Decimal(12, 2)
  unit             String?
  unitPrice        Decimal  @db.Decimal(12, 2)
  taxRate          Decimal? @db.Decimal(5, 2)
  discount         Decimal? @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  receivedQuantity Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model Product {
  id            String        @id @default(cuid())
  tenantId      String
  sku           String
  name          String
  description   String?
  category      String?
  unit          String?
  purchasePrice Decimal?      @db.Decimal(12, 2)
  sellingPrice  Decimal?      @db.Decimal(12, 2)
  taxRate       Decimal?      @db.Decimal(5, 2)
  reorderLevel  Decimal?      @db.Decimal(12, 2)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  invoiceItems       InvoiceItem[]
  inventory          Inventory?
  stockMovements     StockMovement[]

  @@unique([sku, tenantId])
  @@index([tenantId])
  @@index([status, tenantId])
  @@map("products")
}

model Inventory {
  id               String   @id @default(cuid())
  tenantId         String
  productId        String   @unique
  quantity         Decimal  @db.Decimal(12, 2)
  reservedQuantity Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory")
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CreatedStockMovements", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([productId, tenantId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model SalesOrder {
  id                   String           @id @default(cuid())
  tenantId             String
  clientId             String
  orderNumber          String
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               SalesOrderStatus @default(DRAFT)
  subtotal             Decimal          @db.Decimal(12, 2)
  taxAmount            Decimal          @db.Decimal(12, 2)
  discountAmount       Decimal          @db.Decimal(12, 2)
  totalAmount          Decimal          @db.Decimal(12, 2)
  notes                String?
  createdById          String?
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("CreatedSalesOrders", fields: [createdById], references: [id])
  approvedBy User?            @relation("ApprovedSalesOrders", fields: [approvedById], references: [id])
  items      SalesOrderItem[]
  invoices   Invoice[]

  @@unique([orderNumber, tenantId])
  @@index([tenantId])
  @@index([status, tenantId])
  @@index([clientId, tenantId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                String   @id @default(cuid())
  salesOrderId      String
  productId         String
  description       String
  quantity          Decimal  @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal  @db.Decimal(12, 2)
  taxRate           Decimal? @db.Decimal(5, 2)
  taxAmount         Decimal? @db.Decimal(12, 2)
  discount          Decimal? @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  fulfilledQuantity Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model Tenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  status           TenantStatus       @default(ACTIVE)
  maxUsers         Int                @default(10)
  maxStorage       Int                @default(1024)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  memberships      TenantMembership[]
  users            User[]
  clients          Client[]
  leads            Lead[]
  invoices         Invoice[]
  projects         Project[]
  tasks            Task[]
  employees        Employee[]
  attendances      Attendance[]
  leaves           Leave[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  dailyWorkReports DailyWorkReport[]
  timesheets       Timesheet[]
  milestones       Milestone[]
  comments         Comment[]
  attachments      Attachment[]
  followUps        FollowUp[]
  payrolls         Payroll[]
  invoiceItems       InvoiceItem[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  expenses           Expense[]
  vendors            Vendor[]
  purchaseOrders     PurchaseOrder[]
  products           Product[]
  inventories        Inventory[]
  stockMovements     StockMovement[]
  salesOrders        SalesOrder[]

  @@map("tenants")
}

model TenantMembership {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  role     UserRole
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

