generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum PayrollStatus {
  PENDING
  GENERATED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
}

model User {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  password String
  role     UserRole @default(EMPLOYEE)
  isActive Boolean  @default(true)

  employee    Employee?
  clients     Client[]
  attachments Attachment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  managedProjects Project[]      @relation("ProjectManager")
  notifications   Notification[]
  activityLogs    ActivityLog[]
  comments        Comment[]
  Lead            Lead[]

  @@map("users")
}

model Employee {
  id String @id @default(cuid())

  employeeCode String @unique

  phone String?

  designation String?

  department String?

  joiningDate DateTime?

  salary Decimal? @db.Decimal(12, 2)

  address String?

  city String?

  state String?

  country String?

  pincode String?

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt        DateTime          @updatedAt
  Task             Task[]
  attendances      Attendance[]
  leaves           Leave[]
  dailyWorkReports DailyWorkReport[]
  timesheets       Timesheet[]
  payrolls         Payroll[]

  @@map("employees")
}

model Client {
  id String @id @default(cuid())

  companyName String

  contactPerson String

  email String @unique

  phone String?

  gstNumber String?

  website String?

  address String?

  city String?

  state String?

  country String?

  pincode String?

  projects Project[]

  invoices Invoice[]

  isActive Boolean @default(true)

  accountManagerId String?

  accountManager User? @relation(fields: [accountManagerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Project {
  id String @id @default(cuid())

  projectCode String  @unique
  name        String
  description String?

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  startDate   DateTime?
  endDate     DateTime?
  tasks       Task[]
  milestones  Milestone[]
  comments    Comment[]
  attachments Attachment[]
  timesheets  Timesheet[]
  invoices    Invoice[]

  budget Decimal? @db.Decimal(12, 2)

  progress Int @default(0)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  dailyWorkReports DailyWorkReport[]

  @@map("projects")
}

model Task {
  id String @id @default(cuid())

  taskCode    String  @unique
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  estimatedHours Decimal? @db.Decimal(5, 2)
  actualHours    Decimal? @db.Decimal(5, 2)

  projectId  String
  employeeId String?

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  dailyWorkReports DailyWorkReport[]
  comments         Comment[]
  attachments      Attachment[]
  timesheets       Timesheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Attendance {
  id String @id @default(cuid())

  date DateTime @default(now())

  checkIn DateTime?

  checkOut DateTime?

  status String @default("PRESENT")

  remarks String?

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model Leave {
  id String @id @default(cuid())

  leaveType LeaveType @default(CASUAL)

  reason String

  startDate DateTime

  endDate DateTime

  status LeaveStatus @default(PENDING)

  remarks String?

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leaves")
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  isRead Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ActivityLog {
  id String @id @default(cuid())

  action String

  module String

  description String?

  ipAddress String?

  userAgent String?

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@map("activity_logs")
}

model DailyWorkReport {
  id String @id @default(cuid())

  reportDate DateTime

  yesterdayWork String?

  todayWork String

  tomorrowPlan String?

  

  status WorkStatus @default(COMPLETED)

  managerRemarks String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([reportDate])
  @@index([status])
  @@map("daily_work_reports")
}

model Timesheet {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  workDate DateTime

  startTime DateTime?
  endTime   DateTime?

  hours Decimal @db.Decimal(4, 2)

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([workDate])
}

model Milestone {
  id String @id @default(cuid())

  title       String
  description String?

  status   MilestoneStatus   @default(NOT_STARTED)
  priority MilestonePriority @default(MEDIUM)

  progress Int @default(0)

  startDate DateTime
  deadline  DateTime

  completedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Comment {
  id String @id @default(cuid())

  message String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id String @id @default(cuid())

  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  fileUrl      String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploadedBy String
  user       User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  GOOGLE
  REFERRAL
  WHATSAPP
  OTHER
}

model Lead {
  id String @id @default(cuid())

  companyName   String
  contactPerson String

  email String?
  phone String?

  status LeadStatus @default(NEW)
  source LeadSource @default(OTHER)

  estimatedValue Decimal? @db.Decimal(12, 2)

  remarks String?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps FollowUp[]

  @@map("leads")
}

model FollowUp {
  id String @id @default(cuid())

  leadId String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  nextFollowUp DateTime

  remarks String

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("follow_ups")
}

model Payroll {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  basicSalary Decimal @db.Decimal(12, 2)

  totalHours Decimal @default(0) @db.Decimal(6, 2)

  overtimeHours Decimal @default(0) @db.Decimal(6, 2)

  overtimeAmount Decimal @default(0) @db.Decimal(12, 2)

  hra Decimal @default(0) @db.Decimal(12, 2)

  allowances Decimal @default(0) @db.Decimal(12, 2)

  bonus Decimal @default(0) @db.Decimal(12, 2)

  incentives Decimal @default(0) @db.Decimal(12, 2)

  grossSalary Decimal @default(0) @db.Decimal(12, 2)

  pf Decimal @default(0) @db.Decimal(12, 2)

  esi Decimal @default(0) @db.Decimal(12, 2)

  tds Decimal @default(0) @db.Decimal(12, 2)

  deductions Decimal @default(0) @db.Decimal(12, 2)

  totalDeduction Decimal @default(0) @db.Decimal(12, 2)

  netSalary Decimal @db.Decimal(12, 2)

  status PayrollStatus @default(PENDING)

  generatedAt DateTime?

  paidAt DateTime?

  payslipNo String? @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month])
  @@index([year])
}

model Invoice {
  id String @id @default(cuid())

  invoiceNumber String @unique

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  issueDate DateTime
  dueDate   DateTime

  subtotal Decimal @db.Decimal(12, 2)

  tax Decimal @default(0) @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  balanceAmount Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String

  quantity Decimal @db.Decimal(8, 2)

  unitPrice Decimal @db.Decimal(12, 2)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  paymentDate DateTime

  method PaymentMethod

  referenceNo String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}
