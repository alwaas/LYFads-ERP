# ==============================================================================
# LYFADS ERP - Backend Server Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development
PORT=3000

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lyfads_erp_dev?schema=public

# Shadow Database for Prisma Migrations (Development only)
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lyfads_erp_shadow?schema=public

# JWT Secret for User Authentication Tokens
# Generate a secure 256-bit random string in production
JWT_SECRET=super-secret-jwt-token-replace-in-production

# Object Storage / Attachments (Supabase Storage or S3-compatible)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=attachments
